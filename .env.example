# WalletPress — Environment Variables (copy to .env)
# Canonical reference: backend/.env.example

# Admin API key — generate with: openssl rand -hex 32
WP_ADMIN_KEY=change-me-to-a-random-secret

# Vault encryption password — generate with: openssl rand -hex 32
WP_VAULT_PASSWORD=change-me-to-another-random-secret
