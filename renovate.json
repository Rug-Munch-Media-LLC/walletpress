{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "walletpress — extends RugMunch shared preset with pip/npm manager groups",
	"extends": ["local>RugMunchMedia/standards:renovate-presets/rugmunch.json"],
	"assignees": ["cryptorugmunch"],
	"packageRules": [
		{
			"description": "Group all Python pip dependencies",
			"matchManagers": ["pip_requirements", "pip_setup", "pip"],
			"groupName": "Python pip dependencies",
			"groupSlug": "python-pip"
		},
		{
			"description": "Group all JavaScript npm dependencies",
			"matchManagers": ["npm"],
			"groupName": "JavaScript npm dependencies",
			"groupSlug": "js-npm"
		}
	]
}
